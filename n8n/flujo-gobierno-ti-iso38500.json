      "id": "6a8f1fff-9c2f-4484-8283-e04306579046",
      "name": "Leer Assessment",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.2,
      "position": [
        272,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const NIV=[[0.857,5,'Optimizado'],[0.714,4,'Cuantitativo'],[0.571,3,'Definido'],[0.428,2,'Gestionado'],[0.285,1,'Inicial'],[0,0,'Incompleto']];\nconst norm=s=>String(s==null?'':s).trim().toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g,'');\nconst PTS={si:2,parcial:1,no:0};\nconst map={};\nfor(const it of $input.all()){\n  const r=(Array.isArray(it.json.row)?it.json.row:Object.values(it.json)).map(c=>c==null?'':c);\n  const e=r.findIndex(c=>norm(c) in PTS);\n  if(e<0) continue;\n  let tag=null;\n  for(const c of r){const m=String(c).match(/^\\[ISO 38500\\s*[–-]\\s*([^\\]]+)\\]/); if(m){tag=m[1].trim();break;}}\n  if(!tag) continue;\n  const m=map[tag]||(map[tag]={principio:tag,preguntas:0,puntos:0,maximo:0});\n  m.preguntas++; m.puntos+=PTS[norm(r[e])]; m.maximo+=2;\n}\nconst arr=Object.values(map);\nconst P=arr.reduce((a,m)=>a+m.puntos,0), M=arr.reduce((a,m)=>a+m.maximo,0), pc=P/M;\nconst nv=NIV.find(n=>pc>=n[0]);\nreturn arr.map(m=>{const p=m.puntos/m.maximo;\n  return {json:{...m,porcentaje:Math.round(p*1000)/10,\n  lectura:p>=0.7?'Fortaleza':p>=0.4?'En desarrollo':'Brecha',\n  puntos_totales:P,maximo_total:M,porcentaje_global:Math.round(pc*1000)/10,\n  nivel:'Nivel '+nv[1]+' '+nv[2]}}});"
      },
